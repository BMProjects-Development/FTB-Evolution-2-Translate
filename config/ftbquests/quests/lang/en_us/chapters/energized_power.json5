{
  "quest.5F6D849BF0735415.quest_desc": [
    "Batteries in your pocket, battery boxes on the wall.",
    "",
    "Craft a &aBattery Box&r from four Battery V. It stores 65,536 FE and moves 2,048 FE per tick, and the advanced and elite boxes hold 8,388,608 and 268,435,456 FE.",
  ],
  "quest.2418AC7F8E4D0437.title": "Powered Furnace",
  "quest.0004A2325D5DE642.title": "Assembling Machine",
  "quest.45AEC6C17B2D353C.quest_desc": [
    "That Dirty Water is worth keeping.",
    "",
    "Build a &aFiltration Plant&r and feed it Dirty Water and &2Charcoal Filters&r. Every 100 mB has a 33% chance of a stone pebble and a smaller chance at raw ore, and this pack adds 19 metals to its list.",
  ],
  "quest.6CD01296F218E3A9.title": "Upgrade Modules",
  "quest.4314E0DEC99B8C9C.quest_desc": [
    "Express belts step every 2 ticks.",
    "",
    "Craft an &aExpress Conveyor Belt&r set with a belt, a loader and a sorter.",
  ],
  "quest.5C58946645097EBF.title": "Crystallized Lapis Lazuli",
  "quest.39454A3309E666EA.quest_desc": [
    "Elite machines are the last tier of each machine line.",
    "",
    "Build an &aElite Powered Furnace&r and an &2Elite Auto Crafter&r. The furnace smelts seven stacks at once at a twentieth of the vanilla time.",
  ],
  "quest.39454A3309E666EA.title": "Elite Machines",
  "quest.0D6C804C2A6E9ECE.title": "Metal Press",
  "quest.537D4A1C121F9114.quest_desc": [
    "The largest battery box.",
    "",
    "Craft an &aElite Battery Box&r from four Battery X. It holds 268,435,456 FE and moves 16,777,216 FE per tick.",
  ],
  "quest.5FE464F00FF65F8E.quest_desc": [
    "Experience can be stored as a fluid.",
    "",
    "Build an &aXP Drain&r over a &2Tiny XP Storage&r. The drain pulls experience from players standing on it and from nearby orbs and stores it below.",
  ],
  "quest.61B9CB144078F595.title": "Teleporter",
  "quest.535CC5C59EEBAEF1.quest_desc": [
    "Fluids need their own network.",
    "",
    "Craft some &aCopper Fluid Pipe&r and a &2Small Fluid Tank&r. Copper pipe moves 100 mB per tick from each extracting face, steel moves 2,500 and pressurized pipe 10,000. Set which faces extract with the &2Wrench&r.",
    "",
    "A small tank holds 8 buckets, a medium one 32 and a large one 128.",
  ],
  "quest.45AEC6C17B2D353C.title": "Filtration Plant",
  "quest.41381654B022CD0D.quest_desc": [
    "Two small machines for awkward jobs.",
    "",
    "Build a &aBlock Placer&r and an &2Auto Stonecutter&r. The placer puts down any block, even doors and seeds, and the stonecutter runs stonecutter recipes with a pickaxe inside it.",
  ],
  "quest.22059B7A059A6295.title": "Sawmill",
  "quest.694B3717341A77D5.title": "Superconductor",
  "quest.6F21487103C2B864.quest_desc": [
    "Two tools for finding out what a machine is doing.",
    "",
    "Craft an &aEnergy Analyzer&r and a &2Machine Configurator&r. The analyzer shows a block's stored energy, and the configurator copies a machine's side and redstone settings onto another.",
  ],
  "quest.61FB33A5F7FACDB9.title": "Crushing and Pulverizing",
  "quest.22059B7A059A6295.quest_desc": [
    "Wood goes further through a saw.",
    "",
    "Build a &aSawmill&r. One log becomes 6 planks and a pile of sawdust, and it breaks wooden items back down too.",
  ],
  "quest.254F71CE27B713D8.quest_desc": [
    "The fourth frame unlocks the machines that bend the world.",
    "",
    "Craft a &aReinforced Advanced Machine Frame&r from an Advanced frame, four energized crystal matrix and four blocks of silicon.",
  ],
  "quest.4726F0EF568479F8.quest_desc": [
    "The second frame opens up fluids and assembly.",
    "",
    "Craft a &aHardened Machine Frame&r from a Basic frame, iron gears, iron rods, silicon and steel. It unlocks the fluid machines, the Thermal Generator and the Assembling Machine.",
  ],
  "quest.7F452738E6DA6DE2.quest_desc": [
    "A storm is a lot of free power if you can catch it.",
    "",
    "Put a &2Lightning Rod&r on top of a &aLightning Generator&r. Each strike stores 1,000,000 FE, and it sends out up to 65,536 FE per tick.",
    "",
    "A Weather Controller set to thunder brings the storms that make lightning.",
  ],
  "quest.5F6D849BF0735415.title": "Battery Box",
  "quest.39CF1A9F34B62EDD.quest_desc": [
    "Advanced alloy in this pack is the &eFTB Industrial Contraptions&r alloy.",
    "",
    "Make &aAdvanced Alloy&r in the &2Alloy Furnace&r or Induction Smelter from one steel and one aluminum ingot plus two bronze, one electrum or two invar.",
  ],
  "quest.6AD61318102E2CEE.title": "Elite Upgrades",
  "quest.2418AC7F8E4D0437.quest_desc": [
    "Your first machine should replace the furnace.",
    "",
    "Build a &aPowered Furnace&r. It smelts in half the vanilla time for 2 FE per tick, and a &2Blast Furnace Upgrade Module&r or &aSmoker Upgrade Module&r switches it to that recipe type.",
  ],
  "quest.4314E0DEC99B8C9C.title": "Express Conveyors",
  "quest.24394380B59A3DA0.quest_desc": [
    "Power that isn't stored is wasted.",
    "",
    "Build a &aCharger&r and work up to a &2Battery V&r. Each battery tier is crafted from the one before it, and an &2Uncharger&r empties them back into a network.",
  ],
  "quest.4C97C7EB355F1A8C.quest_desc": [
    "Every basic machine has a faster version.",
    "",
    "Build an &aAdvanced Powered Furnace&r, &2Advanced Pulverizer&r and Advanced Crusher. The pulverizer and crusher work four times faster and use 10 mB of water per recipe, and they produce &2Dirty Water&r.",
  ],
  "quest.6A59069E389CBA24.title": "Crystal Growth Chamber",
  "quest.4AD16D2958B25FFB.title": "Auto Crafter",
  "quest.5A08FA1A20258BB2.quest_desc": [
    "Skip the night without a bed.",
    "",
    "Build a &aTime Controller&r. It sets the time to day, noon, night or midnight for 8,388,608 FE each time, and time only ever moves forward.",
  ],
  "quest.5A08FA1A20258BB2.title": "Time Controller",
  "quest.1B51F2E8350A3145.quest_desc": [
    "The mod's blocks are set up with one tool.",
    "",
    "Craft a &aWrench&r. It sets which faces of a pipe extract, the slope of a conveyor belt and the faces of a configurable transformer.",
  ],
  "quest.41381654B022CD0D.title": "Placers and Cutters",
  "quest.4AD16D2958B25FFB.quest_desc": [
    "Crafting by hand stops scaling quickly.",
    "",
    "Build an &aAuto Crafter&r. Give it a crafting pattern and it crafts whenever the ingredients arrive. The Advanced Auto Crafter handles several recipes at once, and the elite one crafts faster still.",
  ],
  "quest.694B3717341A77D5.quest_desc": [
    "The final cable needs a conductor kept cold.",
    "",
    "Assemble &aCoolant Cells&r, then &2Superconductors&r from coolant cells, crystallized lapis, energized alloy plates and energized gold wire.",
  ],
  "quest.11EABC139262D289.quest_desc": [
    "Bulk storage for one item at a time.",
    "",
    "Build a &aTiny Item Silo&r. It holds 50 stacks of a single item and can only be filled and emptied by hoppers, belts and other automation; the giant silo holds 1,000 stacks.",
  ],
  "quest.65A01F46F7044328.quest_desc": [
    "Every machine in the mod is built around a frame, and the &aBasic Machine Frame&r is the first.",
    "",
    "Craft a &aBasic Machine Frame&r. In this pack it takes a &2Steel Ingot&r in the center, which the &aAlloy Furnace&r makes from one iron ingot and one coal.",
    "",
    "A Basic Machine Frame is also the &dElectrician&r's job block, and Electricians trade cable insulators, batteries, cables and a few early machines.",
  ],
  "quest.06701D04327780C6.quest_desc": [
    "One crafter, several recipes.",
    "",
    "Build an &aAdvanced Auto Crafter&r. It holds several patterns at once and crafts twice as fast as the basic one.",
  ],
  "quest.537D4A1C121F9114.title": "Elite Battery Box",
  "quest.5A559FF1147D2459.title": "Charging Station",
  "quest.454517F5F0917F46.title": "Solar Panels",
  "quest.65A01F46F7044328.title": "Basic Machine Frame",
  "quest.1B95E11A97F6D2C6.title": "Thermal Generator",
  "quest.196DBB74F9A47B69.quest_desc": [
    "&eEnergized Power&r is a full tech line, from generators, cables and processing machines up to machines that move players and change the weather.",
    "",
    "Work up through the machine frames from left to right. Each new frame unlocks the next set of machines, and the quests above and below each frame are the machines it opens up.",
    "",
    "&eNote&r: This pack changes the mod in places. The Coal Engine is removed, steel goes into the first frame, and many plates, wires and dusts come from &eFTB Materials&r.",
  ],
  "quest.0004A2325D5DE642.quest_desc": [
    "Circuits past the basic one are assembled, not crafted.",
    "",
    "Build an &aAssembling Machine&r. It makes advanced circuits, processing units, solar cells and the crystal matrix you'll need for the later frames.",
  ],
  "quest.3C141E8FE709BDF2.title": "Weather Controller",
  "quest.64D5A4564AB0C180.title": "Induction Smelter",
  "quest.2A868E9D86980F2C.quest_desc": [
    "The mod writes its own manual.",
    "",
    "Craft the &aEnergized Power Book&r. Left-click any of the mod's blocks with it to open that block's page.",
    "",
    "&eNote&r: A few pages describe things this pack changed, such as the Coal Engine and smelting quartz into silicon.",
  ],
  "quest.3F44E3225E41C7CF.title": "Elite Machine Frame",
  "quest.5C58946645097EBF.quest_desc": [
    "Crystallized Lapis Lazuli is slow to grow.",
    "",
    "Grow &aCrystallized Lapis Lazuli&r in the Crystal Growth Chamber. Eight lapis make one over 128,000 ticks, more than five in-game days before upgrades, but one crystal regrows into more in 32,000, so keep the first one.",
    "",
    "&eNote&r: Its tooltip advises installing two sets of Tier VI upgrades in the chamber before you start.",
  ],
  "quest.3F44E3225E41C7CF.quest_desc": [
    "Expensive alloy goes into the top frame.",
    "",
    "Alloy crystallized lapis, crystal matrix and advanced alloy into &2Crystallized Alloy&r, then energize it into &aEnergized Alloy&r for 8,388,608 FE. Build the &aElite Machine Frame&r from those.",
    "",
    "&eNote&r: The Energizer needs an Energy Capacity Upgrade Module IV or better to hold enough energy for Energized Alloy.",
  ],
  "quest.5A559FF1147D2459.quest_desc": [
    "Stop taking tools out to charge them.",
    "",
    "Build a &aCharging Station&r. It charges the items of every player within 7 blocks, and Range Upgrade Modules stretch that further.",
  ],
  "quest.6AD61318102E2CEE.quest_desc": [
    "Upgrade tiers VII and VIII sit on the elite module.",
    "",
    "Craft an &aElite Upgrade Module&r. A Speed Upgrade VIII makes a machine 40 times faster for 80 times the energy, and an Energy Capacity VIII multiplies storage and transfer by 80.",
  ],
  "quest.39CF1A9F34B62EDD.title": "Advanced Alloy",
  "quest.52A6CCD14E5E5144.quest_desc": [
    "With the Coal Engine gone, early power comes from lava or from solar panels.",
    "",
    "Build a &aHeat Generator&r and put lava against its sides. Each still lava source touching it gives 25 FE per tick and flowing lava gives 15, up to 150 FE per tick with lava on all six faces.",
  ],
  "quest.3CAB8C8CA70E31C9.title": "Plant Growth Chamber",
  "quest.7F452738E6DA6DE2.title": "Lightning Generator",
  "quest.254F71CE27B713D8.title": "Reinforced Advanced Frame",
  "quest.2CE134BC4AFE943F.quest_desc": [
    "Basic belts move an item one step every 10 ticks.",
    "",
    "Craft some &aFast Conveyor Belt&r, which steps every 6 ticks.",
  ],
  "quest.6F21487103C2B864.title": "Analyzers and Configurator",
  "quest.2D9A1A4DBC4D54BC.title": "Stone and Water",
  "quest.61B9CB144078F595.quest_desc": [
    "Walking is for people without 8 million FE to spare.",
    "",
    "Build two &aTeleporters&r and a &2Teleporter Matrix&r. Sneak + Right-click the destination Teleporter with the matrix to link it, put the matrix in the other Teleporter, then stand on it and trigger it with redstone or the teleport keybind.",
    "",
    "Each jump uses the full 8,388,608 FE buffer, and it works across dimensions.",
  ],
  "quest.2CC87ECDB76CCBD1.quest_desc": [
    "The third frame is where the mod gets fast.",
    "",
    "Craft an &aAdvanced Machine Frame&r from a Hardened frame, two advanced alloy, silicon and four brass ingots.",
    "",
    "Brass is zinc and copper alloyed together in the &2Alloy Furnace&r, one ingot of each per brass ingot. Zinc has no ore and comes from pulverizing basalt.",
  ],
  "quest.0D6C804C2A6E9ECE.quest_desc": [
    "Molds need a press.",
    "",
    "Build a &aMetal Press&r. With a mold inside, it presses plates into wires, rods or gears, and every press wears the mold a little.",
    "",
    "Plates come from the &2Compressor&r.",
  ],
  "quest.627553EDEFCE9C01.quest_desc": [
    "Gears and rods don't come from a crafting grid here.",
    "",
    "Build a &aPress Mold Maker&r, shape clay into raw molds and smelt them. A &aGear Press Mold&r and a &2Rod Press Mold&r let the Metal Press make the iron gears and rods the next frame uses.",
    "",
    "Basic molds last 2,000 presses. The hardened, advanced and elite molds last far longer.",
  ],
  "quest.5D5E354DBE1226B7.title": "Crystal Matrix",
  "quest.763CFE19384B50BF.quest_desc": [
    "Turbo belts move an item every tick.",
    "",
    "Craft some &aTurbo Conveyor Belt&r. It needs crystallized alloy, so it comes late.",
  ],
  "quest.454517F5F0917F46.quest_desc": [
    "Solar panels need only open sky and daylight.",
    "",
    "Craft &aSolar Panels&r up to Tier III. Each tier is built from the one before, and in this pack their peak output from Tier I to VII is 2, 16, 64, 256, 512, 4,096 and 16,000 FE per tick.",
    "",
    "&eNote&r: Moon Light Upgrade Modules let them keep working at night.",
  ],
  "quest.1B95E11A97F6D2C6.quest_desc": [
    "Pipe the lava in instead of pouring it around a generator.",
    "",
    "Build a &aThermal Generator&r and feed it lava. In this pack a bucket of lava is worth 10,000 FE, and it burns up to 500 FE per tick.",
  ],
  "quest.5A1884B152041DF2.title": "Conveyor Belts",
  "quest.52A6CCD14E5E5144.title": "Heat Generator",
  "quest.196DBB74F9A47B69.title": "Energized Power",
  "quest.535CC5C59EEBAEF1.title": "Pipes and Tanks",
  "quest.5A1884B152041DF2.quest_desc": [
    "Belts move items without pipes and show you everything on them.",
    "",
    "Craft a &aConveyor Belt&r, a &2Conveyor Belt Loader&r and a Conveyor Belt Sorter. The loader pulls items from an inventory onto the belt, belts insert into whatever they face, and the sorter sends items left, straight or right by filter.",
    "",
    "Splitters, mergers and switches round out each tier.",
  ],
  "quest.6CD01296F218E3A9.quest_desc": [
    "Most machines take upgrades, and the cheapest ones are worth it early.",
    "",
    "Craft a &aBasic Upgrade Module&r and turn it into a &2Speed Upgrade Module I&r. Speed I makes a machine 1.2 times faster for 1.4 times the energy, and Energy Efficiency, Energy Capacity, Item Ejector and Item Pulling modules work the same way.",
    "",
    "Upgrades go into a machine's upgrade screen by hand. Higher tiers are built on advanced, reinforced and elite modules.",
  ],
  "quest.06701D04327780C6.title": "Advanced Auto Crafter",
  "quest.2CE134BC4AFE943F.title": "Fast Conveyors",
  "quest.5FE464F00FF65F8E.title": "Liquid Experience",
  "quest.2CC87ECDB76CCBD1.title": "Advanced Machine Frame",
  "quest.3C141E8FE709BDF2.quest_desc": [
    "Rain on demand, or never again.",
    "",
    "Build a &aWeather Controller&r. It sets clear skies, rain or thunder, and each change empties its 8,388,608 FE buffer. Duration Upgrade Modules make the weather last longer, and Duration VI holds it for as long as the controller is fed.",
  ],
  "quest.2D9A1A4DBC4D54BC.quest_desc": [
    "Water and lava turn into blocks, and blocks turn back into fluids.",
    "",
    "Build a &aStone Solidifier&r, a &2Stone Liquefier&r and a Fluid Freezer. The solidifier makes cobblestone, stone and obsidian from water and lava, the liquefier melts stone into lava, and the freezer turns water into ice and snow.",
  ],
  "quest.2A868E9D86980F2C.title": "Energized Power Book",
  "quest.6A59069E389CBA24.quest_desc": [
    "Some materials can only be grown.",
    "",
    "Build a &aCrystal Growth Chamber&r. It grows amethyst shards, budding amethyst and Crystallized Lapis Lazuli, and in this pack shards and budding blocks for &eGeOre&r gems too.",
    "",
    "It draws 1,024 FE per tick and its recipes take 16,000 to 128,000 ticks, so give it speed upgrades early.",
  ],
  "quest.763CFE19384B50BF.title": "Turbo Conveyors",
  "quest.24394380B59A3DA0.title": "Charging and Batteries",
  "quest.11EABC139262D289.title": "Item Silos",
  "quest.5D5E354DBE1226B7.quest_desc": [
    "The next frame is built on energized crystal.",
    "",
    "Assemble a &aCrystal Matrix&r from amethyst, diamonds, emeralds and redstone alloy, then energize it into an &2Energized Crystal Matrix&r for 524,288 FE.",
  ],
  "quest.627553EDEFCE9C01.title": "Press Molds",
  "quest.4726F0EF568479F8.title": "Hardened Machine Frame",
  "quest.2D1B85CD83A93F5E.title": "Superconductive Cable",
  "quest.4C97C7EB355F1A8C.title": "Advanced Processing",
  "quest.3CAB8C8CA70E31C9.quest_desc": [
    "Farms don't need fields.",
    "",
    "Build a &aPlant Growth Chamber&r. Put a seed in its seed slot and a soil block in its soil slot, and it grows the crop on water and power.",
    "",
    "The soil sets the pace. Farmland grows 1.5 times faster on less energy, mud uses half the water and mycelium doubles the speed of mushrooms. Fertilizer in the third slot speeds it up further at a higher power cost.",
  ],
  "quest.64D5A4564AB0C180.quest_desc": [
    "The Alloy Furnace burns fuel. The &aInduction Smelter&r runs the same alloy recipes on power.",
    "",
    "Build an &aInduction Smelter&r. It finishes alloys in half the time for 64 FE per tick.",
  ],
  "quest.2D1B85CD83A93F5E.quest_desc": [
    "Even Energized Crystal Matrix Cable tops out at 2,097,152 FE per tick.",
    "",
    "Craft &aSuperconductive Cable&r. It carries 16,777,216 FE per tick, the most of any cable in the mod, and like every cable it only connects to other tiers through a transformer.",
  ],
  "quest.1B51F2E8350A3145.title": "Wrench",
  "quest.61FB33A5F7FACDB9.quest_desc": [
    "Two machines break things down, and they do different jobs.",
    "",
    "Build a &aPulverizer&r and a &2Crusher&r. The Pulverizer turns ores and ingots into dust with chance bonus outputs, and the Crusher steps stone down to cobblestone, gravel and sand.",
    "",
    "Both run on 8 FE per tick. Their advanced versions come with the Advanced frame.",
    "",
    "There's no zinc ore to mine. Pulverize &2Basalt&r instead: it gives blackstone with a 5% chance of &aZinc Dust&r, and 10% in the Advanced Pulverizer. A SAG Mill or Macerator works too.",
  ],
}