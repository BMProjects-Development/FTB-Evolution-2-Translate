{
  "quest.7F0A4B19ED4DF750.quest_desc": [
    "Five of Incendium's eight biomes. Visit each one.",
  ],
  "quest.18DE042E91A96693.quest_desc": [
    "Mausoleums, black spirals, haunted ruins, wither caverns and rotting temples all hide the &cSanguine Merchant&r.",
    "",
    "Stock: Neo Vitae runes and reagents, EvilCraft dark gems and blood-waxed coal, and a Blood Pearl of Teleportation.",
    "{@pagebreak}",
    "&bLocations:&r Mausoleum, Black Spiral (Explorify), Haunted Ruin, Wither Cavern, Rotting Temple (ATI)",
    "",
    "&dUnlock:&r Obtain an Ara Vitae",
  ],
  "quest.167F48E2584A3022.title": "&cMog and Gulg",
  "quest.506CE8202884EF43.quest_desc": [
    "Resonance's End biome, full of huge geodes and amethyst spires.",
  ],
  "quest.7638D24AFD676A7F.quest_desc": [
    "Moog's jungle temples are far bigger than the vanilla ones, and a puzzle guards the treasure room.",
    "",
    "Solve it for a good shot at a Totem of Undying or an Enchanted Golden Apple.",
  ],
  "quest.15DA8CCB11B85EA6.quest_desc": [
    "Look for a stone temple on the surface. A shaft beneath it drops into a large dungeon about 47 blocks down.",
    "",
    "Loot boxes come in five tiers, and the legendary ones can roll god-tier armor and tools with enchantments far above their normal maximum.",
    "",
    "&cSome of the chests are rigged with TNT.",
  ],
  "quest.170CF50988CB58E6.quest_desc": [
    "Sky Arenas float between y 120 and y 170. They work like trial chambers, with trial spawners that drop Trial Keys for the vaults.",
    "",
    "The vaults hold diamond gear and the Bolt armor trim, plus a guaranteed Ominous Bottle.",
  ],
  "quest.5AB13D8A178233DD.quest_desc": [
    "Strongholds here are rebuilt versions, full of spawners, libraries and armories, with the End portal room still waiting at the bottom.",
    "",
    "Eyes of Ender lead you to one as usual.",
  ],
  "quest.388CACAF16133436.quest_desc": [
    "Lakes ringed in yellow, orange and black ground, with magma and vents between them. Watch where you step.",
  ],
  "quest.409A27E9A4A6941D.quest_desc": [
    "Draw the reversed Death tarot card, and each nightfall has a 15% chance to bring &cDeath&r himself.",
    "",
    "He has 1,000 health, and no single hit on him does more than 16 damage. He drops his hood, robe, footwear and sickle.",
  ],
  "quest.34FF9A882AA4ABCB.title": "&3Ancient Cities",
  "quest.55B3900E2E519129.quest_desc": [
    "Small ships and ancient vessels carry the &9Swashbuckler&r.",
    "",
    "Stock: Iron's Arms 'n Artifice firearms, ammunition and gun modifiers, along with TNT and a loot crate.",
    "{@pagebreak}",
    "&bLocations:&r Small Ship (MVS), Ancient Vessel (ATi)",
    "",
    "&dUnlock:&r Defeat a Gunslinger or Win a Gunslinger Duel Event ",
  ],
  "quest.7F59F90B1B6F9A67.title": "&bIce Dragon",
  "quest.7AE9316511656205.quest_subtitle": "Wayfarer, Jewler and Beastmaster",
  "quest.4E77F883F5F8C4E7.quest_subtitle": "The Quartermaster, Machinist, Grocer and Apiarist",
  "quest.20393692539B1184.quest_desc": [
    "Dread mausoleums stand in snowy biomes, crawling with dread spawners. The door stays locked until you bring the key.",
  ],
  "quest.19ADE41D01CF22B7.title": "&dLightning Dragon",
  "quest.7465320331494BD7.title": "&6Dragon Caves",
  "quest.6B87A87B53F85BD4.title": "&9Moonlight Grove",
  "quest.21D5042B16907B90.quest_desc": [
    "The underwater version of the stone dungeons, built beneath the ocean floor between y -24 and y 24. Guardian, drowned and stray spawners guard it.",
    "",
    "Its loot boxes add ocean gear to the usual five tiers.",
  ],
  "quest.269CA7E3614C0826.quest_desc": [
    "Sea serpents hunt the open ocean and leap at boats. Ancient ones reach 270 health.",
  ],
  "quest.5758A01C78625749.quest_desc": [
    "Look for the &2Hedge Witch&r in witch huts, mangrove huts, small swamp houses and dark forest settlements.",
    "",
    "Stock: Witchery and Roots Classic supplies, including seeds for the witch plants, taglocks, poppets, ritual chalk and Mutandis.",
    "{@pagebreak}",
    "&bLocations:&r Witch Hut (Terralith), Mangrove Hut (Explorify), Small Swamp House (MVS), Dark Settlement(Explorify)",
    "",
    "&dUnlock:&r Obtain a Witchery Guidebook or a Verdant Sprig",
  ],
  "quest.2965565D68C9761B.quest_desc": [
    "A sunken ship with a Warden on board and eleven chests to loot.",
  ],
  "quest.7B828C91840C23A5.quest_desc": [
    "The &cHovering Inferno&r is a blaze with 700 health and 20 armor, and it carries a Totem of Undying, so plan to kill it twice.",
    "",
    "It drops two artifacts from &eIncendium&r.",
  ],
  "quest.4FE64D008CCF0CA2.title": "&bThe Skylands",
  "quest.250945907CE6EA9D.quest_desc": [
    "A dragon drops nothing when it dies. Right-click the body to harvest it, and each harvest gives something new.",
    "",
    "Scales and blood come first, so bring glass bottles. Bones follow, then the heart, and the skull comes with the last harvest.",
  ],
  "quest.693BD17350005AC9.title": "&dGorgon Head",
  "quest.15DA8CCB11B85EA6.title": "&aStone Dungeons",
  "quest.1F842D40F39C5763.quest_desc": [
    "The largest ruin in the deep oceans. Drowned trial spawners guard chests with tridents, diamond gear and the Coast armor trim.",
  ],
  "quest.1F842D40F39C5763.title": "&3Underwater City",
  "quest.409A27E9A4A6941D.title": "&cDeath",
  "quest.7D5121F9B867A99D.quest_desc": [
    "The &cThunder King&r has 350 health and 10 armor, and he takes half damage while he calls his storm.",
    "",
    "He drops the full Royal armor set and the Royal Glaive.",
  ],
  "quest.42348582DFB34EA1.quest_desc": [
    "Incendium rebuilds the Nether. The five vanilla biomes are still there, and eight new ones join them.",
  ],
  "quest.7AE9316511656205.quest_desc": [
    "Explorify's taverns are the busiest stop on the road, with four shopkeepers inside.",
    "",
    "- &6The Wayfarer&r: travel gear, from waystones and warp scrolls to compasses, the Paraglider and Running Shoes.",
    "- &dThe Jewler&r: Apotheosis sigils, gem cases, tomes and Artisan Scrolls.",
    "- &cThe Beastmaster&r: mob farm parts, pylons, spawner runes and a Monster Spawner.",
    "",
    "The Wayfarer sells the &aNature's Compass&r and the &2Explorer's Compass&r, which find every other place in this chapter.",
    "{@pagebreak}",
    "&bLocation:&r Tavern (Explorify)",
    "",
    "&dUnlock:&r ",
    "&6Wayfarer&r - Obtain Warp Stone, Paraglider, or Natures/Explorers Compass",
    "&dJewler&r - Build a Jewelcrafting Station",
    "&cBeastmaster&r - Craft a Bestiary",
  ],
  "quest.73127D9218A217CB.title": "&cThe Hydra",
  "quest.7F209ECB076B2B30.quest_desc": [
    "The world is full of structures, and this chapter lists the ones worth the trip. Expect dungeons, boss arenas and loot you won't find anywhere else.",
    "",
    "An &aExplorer's Compass&r points to the nearest structure of any type you pick, up to 10,000 blocks away. Most quests here complete as soon as you step inside the structure.",
    "",
    "&cDragons, sirens, cyclopes and the other dangerous Ice and Fire creatures never generate within 2,000 blocks of world spawn.",
  ],
  "quest.30C87E5D353137F6.quest_desc": [
    "Horned Statues hide underground across most of the Overworld. Trade it emeralds and an &aEssence&r for a &2Stamina Vessel&r, which raises your Paraglider stamina.",
    "",
    "It also buys vessels back if you change your mind.",
  ],
  "quest.42348582DFB34EA1.title": "&cThe Nether",
  "quest.6EFD9C957BD47563.quest_desc": [
    "Dread Liches roam the snowy biomes and drop the &bGravemaster's Key&r one time in ten. It opens the mausoleum's keyhole.",
    "",
    "The chests inside can hold an ice dragon heart.",
  ],
  "quest.6933686D0F959FAA.title": "&cFire Dragon",
  "quest.6933686D0F959FAA.quest_desc": [
    "A roost dragon has around 1,100 to 1,200 health, and a fire dragon's breath sets the ground around you alight.",
  ],
  "quest.7638D24AFD676A7F.title": "&aJungle Temples",
  "quest.569357C95D1210AA.quest_desc": [
    "A few &eNautec&r Gateways already sit on the sea floor, each on a small prismarine platform in the open ocean. All of them wear the same four-color address.",
    "",
    "Right-click a fin with an empty hand to read that address. A Gateway you build and dye to match can reach them.",
  ],
  "quest.15C698B306B3B577.title": "&cThe Cyclops",
  "quest.24D8E1226694FEED.title": "&cLeonard",
  "quest.506CE8202884EF43.title": "&dCrystallized End",
  "quest.1BF72D9D4ECB46B8.quest_desc": [
    "The rare chest in a Nether Temple always holds a Netherite Upgrade template, which saves a lot of bastion hunting.",
  ],
  "quest.1D86C25D8DDA3F1E.title": "&cNether Arenas",
  "quest.1D96D2FF800AE80A.title": "&3Ocean Temples",
  "quest.15C698B306B3B577.quest_desc": [
    "The &cCyclops&r has 250 health and hits hard. An arrow to the eye blinds it, and a full sheep disguise hides you while you sneak.",
  ],
  "quest.4FE64D008CCF0CA2.quest_desc": [
    "Floating islands with lakes and waterfalls, hanging above the ocean. Terralith has spring, summer, autumn and winter versions, and any of them counts.",
    "",
    "A &aNature's Compass&r finds any biome by name. The Wayfarer sells one.",
  ],
  "quest.693BD17350005AC9.quest_desc": [
    "The &cGorgon&r's gaze turns you to stone. Wear a &aBlindfold&r or drink a Potion of Blindness before you go down. Mirrors don't help.",
    "",
    "She has 120 health and always drops her head.",
  ],
  "quest.2C3ED0622537D3DD.title": "&cMega Fortress",
  "quest.6B9AD6056DC2E540.quest_desc": [
    "Cyclops caves are carved into beaches, and cyclopes also wander the plains and meadows.",
  ],
  "quest.1FF99FC384C22A24.quest_desc": [
    "The biggest loot cache in the End, with fourteen end city treasure chests behind a garrison of shulkers.",
  ],
  "quest.40892A92CA977BA0.quest_desc": [
    "The slopes of a volcano, with lava springs running down its sides.",
  ],
  "quest.502E257ED1246812.quest_desc": [
    "Hydra caves are dug into swamps and mangrove swamps.",
  ],
  "quest.7465320331494BD7.quest_desc": [
    "The oldest dragons sleep in caves deep underground, between y -24 and y 5, on far bigger hoards than any roost.",
    "",
    "&cCave dragons can have close to 2,500 health.",
  ],
  "quest.21D5042B16907B90.title": "&3Deepslate Dungeons",
  "quest.2B5ECE4CD3F8412B.title": "&3The Fishmonger",
  "quest.170CF50988CB58E6.title": "&aSky Arenas",
  "quest.2913824ED3340F93.title": "&3Nautec Ruins",
  "quest.1A235CAF42A6F6A0.title": "&5The Far End",
  "quest.34FF9A882AA4ABCB.quest_desc": [
    "Ancient cities here are the larger reworked versions, and their chests carry Echo Shards, Enchanted Golden Apples and the Silence armor trim.",
    "",
    "Sculk shriekers call the Warden.",
  ],
  "quest.342991AE8AC9BC34.title": "&cForbidden Castle",
  "quest.5EBF7DD6E28CBBCD.quest_desc": [
    "Dungeon Crawl dungeons go down five levels, and the deepest level is Nether-themed. The spawners carry armed mobs, and secret rooms hide some of the best chests.",
    "",
    "The treasure room pays out stacks of gold, and now and then an Enchanted Golden Apple.",
  ],
  "quest.124F536BB57E1365.quest_desc": [
    "A &cSiren's&r song drags you toward her. Wear &aEarplugs&r and it can't touch you.",
    "",
    "Sirens drop Siren Tears and shiny scales.",
  ],
  "quest.342991AE8AC9BC34.quest_desc": [
    "Deep in the Ash Barrens stands the largest &eIncendium&r build. Piglin brutes and blaze sentries hold it, and its stands display the Scarlet Dagger or the Greatsword of Sacrifice.",
  ],
  "quest.1BF72D9D4ECB46B8.title": "&cNether Temple",
  "quest.569357C95D1210AA.title": "&3Sunken Gateways",
  "quest.49A2DD994F720F84.quest_desc": [
    "The Nether version of the stone dungeons, between y 24 and y 90. Blaze, wither skeleton and piglin brute spawners guard their own high-roller loot table.",
  ],
  "quest.203E01E473B7DCFA.title": "&cThe Horned Huntsman",
  "quest.33D0A75727D9CB58.quest_subtitle": "Gatekeeper and Gambler",
  "quest.656B7E686D7EBBE4.title": "&bThunder Court",
  "quest.49A2DD994F720F84.title": "&cNether Dungeons",
  "quest.7F59F90B1B6F9A67.quest_desc": [
    "Ice dragon breath freezes whatever it touches, you included. Keep moving so it can't pin you in place.",
  ],
  "quest.5758A01C78625749.title": "&2The Hedge Witch",
  "quest.57A55BDA10B81ACB.title": "&dThe End",
  "quest.57A55BDA10B81ACB.quest_desc": [
    "Past the main island, most of the outer End belongs to Nullscape and Resonance biomes.",
  ],
  "quest.5A03706C37C733CE.title": "&dThe Arcanist",
  "quest.5AB13D8A178233DD.title": "&aStrongholds",
  "quest.4E77F883F5F8C4E7.quest_desc": [
    "Shopkeepers set up in the places they belong. Walk into a village and up to four of them arrive, with a message in chat for each one. Right-click a shopkeeper with an empty hand to open their shop.",
    "",
    "- &bThe Quartermaster&r: backpack and storage upgrades, drawers, and starter parts for AE2 and Refined Storage.",
    "- &cThe Machinist&r: machine parts from the tech mods, and the infinity cells.",
    "- &aThe Grocer&r: seeds, crops, farm animal spawn eggs and kitchen tools.",
    "- &6The Apiarist&r: bee cages, nests and hive upgrades. The Apiarist only comes to villages in plains, sunflower plains, meadow and savanna biomes.",
    "{@pagebreak}",
    "&bLocation:&r Villages",
    "",
    "&dUnlock:&r ",
    "&bQuartermaster&r - Upgrade a Backpack or Storage Chest",
    "&cMachinist&r - Craft any basic circuit",
    "&aGrocer&r - Eat something",
    "&6Apiarist&r - Catch a bee in a bee cage",
  ],
  "quest.1754F4058CB200D4.title": "&dDragon Seeker",
  "quest.19ADE41D01CF22B7.quest_desc": [
    "Lightning dragons call strikes down with their breath. They are the most widespread of the three, so you'll likely meet one first.",
  ],
  "quest.33D0A75727D9CB58.title": "&6Manor Dealers",
  "quest.46EEC36A2FA7A0D0.title": "&dMirage Isles",
  "quest.388CACAF16133436.title": "&6Yellowstone",
  "quest.250945907CE6EA9D.title": "&6Harvesting a Dragon",
  "quest.203E01E473B7DCFA.quest_desc": [
    "Build a Wicker Man from Blood-Stained Hay and set it alight with flint and steel, and the &cHorned Huntsman&r answers.",
    "",
    "He has 150 health and drops the Huntsman Spear.",
  ],
  "quest.1754F4058CB200D4.quest_desc": [
    "The &dDragon Seeker&r points you to the nearest dragon. Its range grows from 150 blocks to 300 as you upgrade it.",
    "",
    "It only finds dragons in loaded chunks, so use it on the move.",
  ],
  "quest.656B7E686D7EBBE4.quest_desc": [
    "Thunder Courts stand in plains, meadows and forests, and each one holds a single &cThunder King&r.",
  ],
  "quest.7F0A4B19ED4DF750.title": "&cNether Wilds",
  "quest.7EE3B916522A9170.title": "&aGorgon Temple",
  "quest.5EBF7DD6E28CBBCD.title": "&aDungeon Crawl",
  "quest.2B5ECE4CD3F8412B.quest_desc": [
    "Underwater temples hold the &3Fishmonger&r's shop.",
    "",
    "Fishing tackle and bait for Starcatcher, Nautec parts and bacteria cultures, and fish tanks.",
    "",
    "Bring a way to breathe underwater.",
    "{@pagebreak}",
    "&bLocations:&r Underwater Village Temple (intact, broken or ruined) ",
    "",
    "&dUnlock:&r Catch a fish",
  ],
  "quest.7AE9316511656205.title": "&6Tavern Regulars",
  "quest.1D86C25D8DDA3F1E.quest_desc": [
    "Trial chambers for the Nether, with wither skeleton, blaze and magma cube trial spawners guarding the vaults.",
    "",
    "The rare Dragon Arena's vaults can hold a Heavy Core.",
  ],
  "quest.7B828C91840C23A5.title": "&6The Hovering Inferno",
  "quest.7D5121F9B867A99D.title": "&6The Thunder King",
  "quest.2C3ED0622537D3DD.quest_desc": [
    "A huge fortress that can turn up anywhere in the Nether. Its chests can hold Netherite Ingots and upgrade templates.",
  ],
  "quest.319428452110100A.quest_desc": [
    "Moog's mega ships drift through the outer End with a Wither Skeleton captain on board.",
    "",
    "They carry Elytra in item frames, so they're a second Elytra source besides end cities.",
  ],
  "quest.6EFD9C957BD47563.title": "&bGravemaster's Key",
  "quest.120E37CE2AB140FA.title": "&cInfernal Altar",
  "quest.7063420D36849583.quest_desc": [
    "Siren islands rise out of the open ocean. Listen for the singing before you see them.",
  ],
  "quest.120E37CE2AB140FA.quest_desc": [
    "The Infernal Altar stands in the Infernal Dunes. Throw a Nether Star onto it to summon its guardian.",
  ],
  "quest.269CA7E3614C0826.title": "&cSea Serpents",
  "quest.6A7DB2334016638A.quest_desc": [
    "Adult dragons nest on the surface on a pile of treasure. Fire dragons live in deserts and volcanic land, ice dragons in snowy biomes, and lightning dragons in jungles, badlands, savannas and swamps.",
    "",
    "Fire and ice dragons sleep at night, lightning dragons during the day. Your first hit wakes them.",
  ],
  "quest.1A235CAF42A6F6A0.quest_desc": [
    "Nullscape's three biomes out in the void.",
    "",
    "- &0Shadowlands&r: blackstone and basalt with bone trees.",
    "- &7Void Barrens&r: bare End stone and little else.",
    "- &bCrystal Peaks&r: crystal formations.",
  ],
  "quest.24D8E1226694FEED.quest_desc": [
    "&cLeonard&r comes from a cauldron brew that needs a Witches' Hat. He has 500 health, fights in three phases and drops Leonard's Urn.",
  ],
  "quest.502E257ED1246812.title": "&aHydra Cave",
  "quest.25975DB5C7ADE870.quest_desc": [
    "An &cElder Guardian&r guards every ocean temple and monument. Its curse slows your mining, so kill it before you start breaking walls.",
  ],
  "quest.18DE042E91A96693.title": "&cThe Sanguine Merchant",
  "quest.30C87E5D353137F6.title": "&aThe Horned Statue",
  "quest.33D0A75727D9CB58.quest_desc": [
    "Manors and marble chateaus hold the pack's most expensive shops.",
    "",
    "- &6The Gatekeeper&r: Gate Pearls, Trial Keys and the Apothic Invader Summoner.",
    "- &6The Gambler&r: loot crates from 25 to 750 coins. He only trades once you've opened a loot crate of your own.",
    "",
    "{@pagebreak}",
    "&bLocations:&r Manor, Marble Chateau (ATi)",
    "",
    "&dUnlock:&r ",
    "GateKeeper - Obtain a Gateway, ",
    "Gambler - Open a Loot Crate",
  ],
  "quest.6A7DB2334016638A.title": "&6Dragon Roosts",
  "quest.20393692539B1184.title": "&bDread Mausoleum",
  "quest.7F209ECB076B2B30.title": "&6Exploration",
  "quest.167F48E2584A3022.quest_desc": [
    "Give the Hobgoblin Patron statue a Nether Star and &cMog&r and &cGulg&r arrive together, with 400 health each.",
    "",
    "They drop Mog's Quiver and Gulg's Gurdle.",
  ],
  "quest.7EE3B916522A9170.quest_desc": [
    "Gorgon temples stand on beaches. The gorgon waits in the basement, behind a trapdoor that switches open.",
  ],
  "quest.2965565D68C9761B.title": "&3Ancient Vessel",
  "quest.2913824ED3340F93.quest_desc": [
    "Small dark prismarine ruins dot the ocean floor, and each arch still holds a working &aAquatic Catalyst&r. That catalyst is your first laser, and it's how you get started with &eNautec&r's laser crafting.",
    "",
    "Break it and take it home. The &aRusty Crate&r beside it holds &2Prismarine Laser Relays&r and other parts, but its lock is corroded shut. Drop it into &2Etching Acid&r to clean it, then open the clean &aCrate&r like a chest. Brushing the &aSuspicious Gravel&r around the ruin turns up the same parts.",
  ],
  "quest.1FF99FC384C22A24.title": "&dEnderkeep Courtyard",
  "task.6BADEBBA351BFE5C.title": "Any Dragon Skull",
  "quest.4E77F883F5F8C4E7.title": "&6Village Traders",
  "quest.6B87A87B53F85BD4.quest_desc": [
    "A forest of blue flowers, with amethyst growing out of the ground.",
  ],
  "quest.1D96D2FF800AE80A.quest_desc": [
    "Moog's ocean temples sit on deep sea floors. The treasure room holds a Heart of the Sea one time in four.",
  ],
  "quest.7063420D36849583.title": "&aSiren Island",
  "quest.46EEC36A2FA7A0D0.quest_desc": [
    "Islands of enchanted trees and giant mushrooms, far out in the deep ocean.",
  ],
  "quest.25975DB5C7ADE870.title": "&cElder Guardian",
  "quest.6B9AD6056DC2E540.title": "&aCyclops Cave",
  "quest.124F536BB57E1365.title": "&cSirens",
  "quest.55B3900E2E519129.title": "&9The Swashbuckler",
  "quest.40892A92CA977BA0.title": "&cVolcanic Peaks",
  "quest.5A03706C37C733CE.quest_desc": [
    "Terralith's mage towers and mage complexes are home to the &dArcanist&r.",
    "",
    "Stock: Ars Magica reagents and runes, mage armor and the Affinity Tomes, plus a few heart items from Baubley Heart Canisters.",
    "{@pagebreak}",
    "&bLocations:&r Mage Tower, Mage Complex (Terralith)",
    "",
    "&dUnlock:&r Obtain Vinteum Dust",
  ],
  "quest.319428452110100A.title": "&dMega Ships",
  "quest.73127D9218A217CB.quest_desc": [
    "The &cHydra&r has 550 health. Every head you cut off grows back as two, up to nine, and it heals unless it's burning.",
    "",
    "Set it on fire and keep it burning.",
  ],
  "task.52CD1A19C7C03226.title": "Visit any Skylands biome",
}