{
  "quest.37AC6DFD70F4A32B.quest_desc": [
    "The &6Architectural Building Wand&r mod adds drag and drop construction based wands for building.",
    "",
    "If you're a builder, you'll fall in love with these.",
  ],
  "quest.0A8F17889C23A3F5.quest_desc": [
    "&2Crafting on a Stick&r adds portable versions of vanilla workstations to the pack!",
    "",
    "The Crafting Table, Stonecutter, Loom, Grindstone, Smithing Table, Cartography Table and Anvil can each be crafted with a stick to use on the go.",
    "",
    "They also fit in their own curio slot and can be opened with a keybind.",
  ],
  "quest.2B6A9A76B6DA7B43.title": "&aMagnets",
  "quest.78CD596A63855214.title": "&bJEI",
  "quest.2B6A9A76B6DA7B43.quest_desc": [
    "The &aBasic Magnet&r pulls items and experience from 5 blocks away. The &aAdvanced Magnet&r can be set anywhere from 3 to 11 blocks.",
  ],
  "quest.32CC8C6B1DE5504C.title": "&cTrash Slot",
  "quest.5ED79D0B659DFEAF.title": "&cWhen You Die",
  "quest.390741EBD01E0634.title": "&fElevators",
  "task.2ADE6F77F949613F.title": "Sleeping Bags",
  "quest.1E5E83D8109F9495.title": "&6Jetpack Flight",
  "quest.1E5E83D8109F9495.quest_desc": [
    "&aSimply Jetpacks&r adds flight without needing to get an &dElytra&r.",
    "",
    "You'll need to be able to make &2alloys&r before you are able to craft one, starting with Bronze.",
    "",
    "&bJ&r turns the engine on and &bH&r toggles hover. Page Up and Page Down change the throttle.",
  ],
  "quest.493BC709709F7B7C.quest_desc": [
    "&dPuffish Skills&r adds custom skill trees that level with you as you play the pack.",
    "",
    "You have five skill trees: Melee, Ranged, Athletics, Mining, and Magic. Each one levels from its own kind of play, and every level gives you a point to spend in that tree.",
    "",
    "[\"\", \"You can reset your skill trees with their respective quests in the \", {\"text\": \"Gearing Up\", \"color\": \"aqua\", \"underlined\": true, \"click_event\": {\"action\": \"custom\", \"id\": \"ftbquests:link\", \"payload\": {\"quest_id\": \"2EF5133328945047\"}}, \"hover_event\": {\"action\": \"show_text\", \"value\": \"Open the Gearing Up chapter\"}}, \" chapter.\"]",
    "",
    "[\"\", \"Some nodes unlock special abilities, such as \", {\"text\": \"Air Dash\", \"color\": \"dark_green\"}, \" (\", {\"keybind\": \"key.ftbevolutioncompanion.air_dash\", \"color\": \"yellow\", \"hover_event\": {\"action\": \"show_text\", \"value\": \"Default: V\"}}, \"), \", {\"text\": \"Ninja\", \"color\": \"light_purple\"}, \" (\", {\"keybind\": \"key.ftbevolutioncompanion.activate_ninja\", \"color\": \"yellow\", \"hover_event\": {\"action\": \"show_text\", \"value\": \"Default: N\"}}, \"), \", {\"text\": \"Wall Climb\", \"color\": \"green\"}, \", \", {\"text\": \"Blademaster\", \"color\": \"gold\"}, \" and \", {\"text\": \"Cheat Death\", \"color\": \"light_purple\"}, \".\"]",
    "",
    "[\"\", \"To access the skill trees, press \", {\"keybind\": \"key.puffish_skills.open\", \"color\": \"yellow\", \"hover_event\": {\"action\": \"show_text\", \"value\": \"Default: K\"}}, \".\"]",
    "{@pagebreak}",
    "&cMelee&r levels from hitting and killing up close, blocking with a shield and taking hits.",
    "",
    "&bRanged&r levels from bows, crossbows, tridents, guns and grenades.",
    "",
    "&aAthletics&r levels from sprinting, climbing, swimming, jumping and fishing.",
    "",
    "&7Mining&r levels from breaking ore, obsidian and Sky Stone.",
    "",
    "&dMagic&r levels from all of the pack's magic mods. Spells, rituals, rites, brews, soul work and enchanting all count, whichever school you follow.",
    "",
    "[\"\", \"The \", {\"text\": \"Skill Trees\", \"color\": \"aqua\", \"underlined\": true, \"click_event\": {\"action\": \"custom\", \"id\": \"ftbquests:docs\", \"payload\": {\"location\": \"guideme,ftb:skills,ftb:index.md\"}}, \"hover_event\": {\"action\": \"show_text\", \"value\": \"Open the Skill Trees guide\"}}, \" guide lists exactly how much XP each action gives.\"]",
    "{@pagebreak}",
  ],
  "quest.1BBCB850732E8104.title": "&cTrash Cans",
  "quest.1BBCB850732E8104.quest_desc": [
    "If you need to delete something in the world, there's a &aTrashcan&r for it.",
    "",
    "These can be piped into to void anything you might want to get rid of.",
  ],
  "task.1FC6BA9D1B087F7E.title": "Crafting On A Stick",
  "quest.5ED79D0B659DFEAF.quest_desc": [
    "When you die, &aGraveless&r keeps your items together as a ghost where you died.",
    "",
    "Clicking your ghost to give everything back, or sneak and click to pick items out one at a time. It can be reached from up to 16 blocks away.",
    "",
    "Within 256 blocks of your own grave, you get &bSpirit Ward&r for two minutes. It makes you invisible and gives you night vision, and mobs ignore you.",
    "",
    "&b/graveless allow <player>&r lets a teammate collect your items for you.",
  ],
  "quest.5A11E2B3CCCF089A.quest_desc": [
    "Out on an adventure and can't make it back home? ",
    "",
    "Sleep in a &aSleeping Bag&r at night or a &2Hammock&r during the day to skip the night or day without resetting your spawn point!",
    "",
    "It also keeps the &dPhantoms&r away.",
  ],
  "quest.5D6A81A1C79814F5.quest_desc": [
    "&aCrafting Tweaks&r adds several quality of life keybinds to make crafting easier.",
    "",
    "Pressing &bK&r while in a crafting table and hovering over an item will compress it.",
    "",
    "Pressing &bTab&r fills the crafting grid with the last recipe you made, taking the ingredients from your inventory.",
  ],
  "task.7D99836BEA37744F.title": "Magnum Torches",
  "quest.4B1C972E286927AF.quest_desc": [
    "Can be used to get around early-game.",
    "",
    "Also can be used on tamed Horses to make them fly!",
  ],
  "quest.493BC709709F7B7C.title": "&dSkills",
  "task.47C89DF8F05D8DA1.title": "Tips \\&\\ Tricks",
  "task.7E9BE044ABAA32ED.title": "Jetpacks",
  "quest.23F32119C3D6CF53.quest_desc": [
    "The &aTool Belt&r has its own slot and holds any tool or other item that doesn't stack.",
    "",
    "Its keys ship unbound. Bind them in &bControls&r to swap tools without opening your inventory.",
  ],
  "task.0B969503888E6D4D.title": "Construction Sticks",
  "quest.32CC8C6B1DE5504C.quest_desc": [
    "Your inventory screen has an extra slot that deletes whatever you put in it.",
    "",
    "&bT&r shows or hides it, and &bDelete&r destroys the item under your cursor.",
  ],
  "quest.72BBE5DADD0E4B7F.quest_desc": [
    "Right-clicking a fully grown crop will harvest it without needing to break the seed.",
    "",
    "If you hold the vein mining key while you right-click, it will harvest the whole area at once!",
    "",
    "&aTip&r: This also works for things like tilling the ground or stripping wood.",
  ],
  "quest.37AC6DFD70F4A32B.title": "&6Architectural Building Wands&r",
  "task.632B881A33EB0799.title": "Hammocks",
  "quest.4B1C972E286927AF.title": "&bParaglider",
  "quest.08A79920751CC95D.title": "&aCrouch to Grow",
  "quest.390741EBD01E0634.quest_desc": [
    "&aElevators&r help you create floors within your base!",
    "",
    "These work by placing them in a column. Jump on one to go up to the next, and sneak to go down. They work up to 384 blocks apart.",
  ],
  "quest.78CD596A63855214.quest_desc": [
    "One of the most important skills in modded Minecraft is learning to use &aJEI&r.",
    "",
    "[\"\", \"If you hover over any item and press \", {\"keybind\": \"key.jei.showRecipe\", \"color\": \"yellow\", \"hover_event\": {\"action\": \"show_text\", \"value\": \"Default: R\"}}, \", you can see its crafting recipes or \", {\"keybind\": \"key.jei.showUses\", \"color\": \"yellow\", \"hover_event\": {\"action\": \"show_text\", \"value\": \"Default: U\"}}, \" for its uses.\"]",
    "",
    "[\"\", {\"keybind\": \"key.jei.bookmark\", \"color\": \"yellow\", \"hover_event\": {\"action\": \"show_text\", \"value\": \"Default: A\"}}, \" bookmarks the crafting recipe on the left side of your screen for later, \", {\"keybind\": \"key.jei.focusSearch\", \"color\": \"yellow\", \"hover_event\": {\"action\": \"show_text\", \"value\": \"Default: CTRL + F\"}}, \" jumps to the search bar and \", {\"keybind\": \"key.jei.recipeBack\", \"color\": \"yellow\", \"hover_event\": {\"action\": \"show_text\", \"value\": \"Default: Backspace\"}}, \" goes back a page.\"]",
  ],
  "quest.567D0EF74A1C1AC8.quest_desc": [
    "There are &oa lot&r of &aKeybinds&r in this pack.",
    "",
    "The &bControls -> Keybinds&r screen has a search bar to help you locate each specific one.",
    "",
    "If you ever have keybind problems, this is where to start.",
    "",
    "&aNote&r: There are plenty of useful keybinds that ship &bUnbound&r, like &aOpen Quests&r.",
  ],
  "quest.23F32119C3D6CF53.title": "&aTool Belt",
  "quest.47567BF7AAB58A9A.quest_desc": [
    "&aMagnum Torches&r help control mob spawning around your base by preventing them from spawning up to 4 chunks out.",
    "",
    "Placing down a &bDiamond Magnum Torch&r will prevent hostile mobs from spawning, while &2Emerald Magnum Torches&r prevent passive mobs.",
    "",
    "&dAmethyst Magnum Torches&r are great for underwater bases as they prevent aquatic spawns.",
  ],
  "quest.72BBE5DADD0E4B7F.title": "&aBulk Farming",
  "quest.7A85DDFE6B7C4877.title": "Better Building Tools",
  "quest.2C5CFE054A8C2754.quest_desc": [
    "A &aWarp Stone&r teleports you to any waystone you have already activated. Each trip costs experience, with more of a cost for longer distances.",
    "",
    "The &6Broker&r at the spawn pyramid sells one!",
  ],
  "quest.08A79920751CC95D.quest_desc": [
    "[\"\", \"Tapping \", {\"keybind\": \"key.sneak\", \"color\": \"yellow\", \"hover_event\": {\"action\": \"show_text\", \"value\": \"Default: Left Shift\"}}, \" over and over next to your crops will make them grow faster. Each crouch gives every plant within 3 blocks a chance to grow.\"]",
    "",
    "Each crop that grows &ccosts 1 XP point&r, and nothing grows while you have no XP at all.",
    "",
    "This also works on saplings and budding blocks too, such as &dBudding Amethyst&r, &bCertus Quartz&r and &2GeOre Geodes&r.",
    "",
    "&aPro Tip&r: Holding a &aGrass Block&r in your off hand while Squat Growing will cause grass to spread over dirt.",
    "",
    "[\"\", \"Use \", {\"keybind\": \"key.squatgrow.toggle\", \"color\": \"yellow\", \"hover_event\": {\"action\": \"show_text\", \"value\": \"Default: U\"}}, \" to turn crouch growth off or back on. Find Toggle Squat Grow in Controls if you need to bind it.\"]",
  ],
  "quest.18FF9811FBC860BD.quest_desc": [
    "The &2Crafting Station&r makes crafting much easier by pulling from adjacent storages!",
    "",
    "Place it next to any storage block and using the crafting table will show you the inventory inside of it.",
  ],
  "quest.5D6A81A1C79814F5.title": "&bCrafting Tweaks",
  "quest.0A8F17889C23A3F5.title": "Crafting...On A Stick!",
  "task.5BC3F8DA8B4D9898.title": "Late Game Wand Setup",
  "quest.5A11E2B3CCCF089A.title": "&aSleeping Bags and Hammocks",
  "quest.6E7A3D79BEA2B8D6.title": "&aUltimining",
  "quest.2C5CFE054A8C2754.title": "&dWarp Stone",
  "quest.7A85DDFE6B7C4877.quest_desc": [
    "&aConstruction Sticks&r adds several tiers of building wands to help you build out your base.",
    "",
    "These fancy sticks help extend blocks out, with the higher tiers extending out up to 512 blocks at a time.",
  ],
  "quest.6E7A3D79BEA2B8D6.quest_desc": [
    "Hold &b`&r (the key under Escape) while you break a block to mine the whole vein, up to 16 blocks at once. The &bUp&r and &bDown&r arrows change the shape, or you can scroll with your mousewheel while holding the keybind.",
    "",
    "Every block costs hunger, so eat before a big dig. The &dMining Skill Tree&r raises the block limit to a max of 192, and can eventually reduce the cost to nothing.",
  ],
  "task.445B1B96E2572DC2.title": "Elevators",
  "quest.47567BF7AAB58A9A.title": "&6Magnum Torches",
  "quest.567D0EF74A1C1AC8.title": "&bFinding Keys",
}