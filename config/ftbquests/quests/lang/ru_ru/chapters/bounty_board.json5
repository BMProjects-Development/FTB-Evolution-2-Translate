  ],
  "quest.6DC738A434C5B02F.quest_desc": [
    "Look at one to make it angry, then duck under a ceiling two blocks high. An &dEnderman&r is too tall to follow you in.",
  ],
  "quest.24445EC4DA6492F1.quest_subtitle": "Defend A Village From A Raid",
  "quest.29E78B39C74FBC4E.quest_desc": [
    "This is the vanilla Monsters Hunted advancement. It wants 41 different mobs, including the &dEnder Dragon&r, the &5Wither&r and an &cElder Guardian&r, so it takes a while.",
    "",
    "Only vanilla mobs are on the list. The Advancements screen shows your progress.",
  ],
  "quest.1F70A066744E64EA.title": "Play for &d50 Hours",
  "quest.24445EC4DA6492F1.quest_desc": [
    "You'll need &cBad Omen&r to trigger a raid. Raid captains drop &cOminous Bottles&r; drink one near a village, then hold the line.",
  ],
  "quest.232E1BBB91DEF799.quest_desc": [
    "That's 2,400 hours of playtime. Nobody's expected to finish this one.",
