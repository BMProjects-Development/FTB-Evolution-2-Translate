{
  "quest.607211F8C680B88A.title": "&aДвери",
  "quest.45979A90BFA03AA6.title": "&aФонари и светильники",
  "task.19CEA73CCF4221E2.title": "Любой гамак",
  "quest.672FEF37D5F5783C.title": "&3Жезл для настройки стекла",
  "quest.6AECB7C2DF87D34F.quest_desc": [
    "Мод &e«Стекло с особыми свойствами»&r добавляет необычные виды стекла. Через &aэфирное стекло&r могут проходить игроки, но не мобы. С его помощью Вы сможете сделать проход в стене, который будет недоступен существам.",
    "",
    "У &aобратного эфирного стекла&r всё наоборот: оно задерживает игроков, но пропускает остальных существ. Кроме того, мод позволяет обычным стеклянным блокам визуально соединяться друг с другом.",
  ],
  "quest.1914278B9065D883.title": "&aКрыши",
  "quest.2030D1D78E2AA7DE.quest_desc": [
    "Для массового изготовления декоративных блоков используйте &aавтоматическую стамеску&r. Положите в неё обычную стамеску, блок-образец с нужным узором и исходные блоки. Устройство будет последовательно превращать их в выбранный вариант.",
    "",
    "Энергия не требуется. Если подавать блоки через воронку, можно без ручной работы подготовить материалы для целой стены.",
  ],
  "quest.45979A90BFA03AA6.quest_desc": [
    "Нажмите ПКМ по светильнику, чтобы включить или выключить его. Краситель позволит изменить цвет. Факелы в тропическом стиле можно делать выше.",
  ],
  "quest.12A77A3CB31A42F4.quest_desc": [
    "Деревянные мосты создаются на верстаке, а каменные — на камнерезе. Если мост имеет ширину хотя бы в два блока, возьмите &aплоскогубцы&r и нажмите по нему ПКМ, чтобы сделать проход.",
  ],
  "task.575442B006482AD9.title": "Любая стамеска",
  "quest.377E6E387004CA7E.quest_desc": [
    "Большинство строительных модов в сборке используют &aкамнерез&r для создания декоративных вариантов блоков. Так работают &e«Улучшенные строительные блоки»&r, &e«Декоративные деревянные решётки»&r и несколько модов серии &eMacaw’s&r.",
    "",
    "Каждая ветка заданий посвящена отдельному виду строительства. Эти задания не обязательны для дальнейшего прохождения сборки, поэтому начинайте с того, что пригодится для Вашей базы.",
    "",
    "Выберите интересующий блок в &eJEI&r, чтобы увидеть доступные варианты обработки.",
  ],
  "quest.4307A169AF52A267.title": "&aСветящееся стекло и стекло с редстоуном",
  "quest.7F55F51B79B150FB.quest_desc": [
    "Мод &e«Декоративное освещение»&r позволяет создавать светильники из блоков &a«Киберсвет»&r, входящих в набор «Улучшенные строительные блоки». Сначала изготовьте световые панели, а затем используйте камнерез, чтобы получить накладки, лампы, фонари, пластины и световые полосы.",
  ],
  "quest.6AECB7C2DF87D34F.title": "&eСтекло с особыми свойствами",
  "quest.1F9D424E8172A112.title": "&aАквариум",
  "quest.6D8E5365B422735D.quest_desc": [
    "В моде &e«Улучшенные строительные блоки»&r блоки объединены в тематические наборы. С помощью камнереза базовый блок каждого набора можно превратить в один из 15 вариантов. Для начала понадобится &aоснова набора (Blockz Core Base)&r.",
    "",
    "Менять внешний вид блока в руке можно и без камнереза. Для этого назначьте две клавиши в разделе «Z-Core» настроек управления: &b«Экран выбора варианта»&r и &b«Модификатор прокрутки колеса мыши»&r.",
  ],
  "quest.23BAF609BE4D464F.quest_desc": [
    "В этой сборке обычное стекло уже соединяется без видимых границ, поэтому мод &e«Бесшовное стекло»&r полезен прежде всего дополнительными видами стекла. &aСтыкующееся стекло&r не имеет рамок; из него можно изготовить &2чистое стекло&r, а затем — поцарапанное.",
  ],
  "quest.23B44ACF78688229.quest_desc": [
    "Серия &eMacaw’s&r включает шесть строительных модов. Каждый отвечает за отдельные детали: крыши, окна, мосты, двери, дорожки или освещение.",
    "",
    "Большинство деталей изготавливаются на верстаке или камнерезе. У каждого мода есть свои инструменты и особенности, о которых рассказывается в соседних заданиях.",
  ],
  "quest.3F05300BC56B409C.quest_desc": [
    "Декоративные покрытия для дорожек создаются на камнерезе. Нажмите ПКМ по установленному покрытию киркой, чтобы выгравировать на нём узор, или лопатой, чтобы сделать поверхность ровной.",
  ],
  "quest.672FEF37D5F5783C.quest_desc": [
    "Используйте &3жезл для настройки стекла&r на блоках Crystalix, чтобы изменить их свойства. Если при использовании присесть, настройки применятся сразу ко всем соединённым блокам.",
    "",
    "Меню жезла открывается действием &b«Открыть редактор жезла»&r. По умолчанию клавиша для него не назначена. Найдите это действие в разделе Crystalix настроек управления.",
  ],
  "quest.29FE9DA4102EBB42.quest_desc": [
    "Блокам из мода &e«Каркасные блоки»&r можно придать внешний вид практически любого другого блока. Возьмите нужный блок в руку и нажмите ПКМ по каркасу, чтобы облицевать его.",
    "",
    "При облицовке блок расходуется, но его можно вернуть, сняв покрытие &aкаркасным молотком&r. Для поворота установленного каркаса используйте &aкаркасный ключ&r.",
  ],
  "quest.1749497FC966AEFB.quest_desc": [
    "Чтобы поймать рыбу живой, возьмите &aсумку для переноски рыбы&r и нажмите ПКМ по рыбе. В одну сумку помещается только одна рыба.",
  ],
  "quest.22BB5B95E316458D.quest_desc": [
    "&aРедстоуновый строительный жезл&r позволяет возводить целые фигуры за одно действие: прямоугольные объёмы, круги и треугольники. Они могут быть заполненными, полыми или состоять только из стенок.",
    "",
    "Перед использованием назначьте клавиши в разделе «Строительный жезл архитектора» настроек управления. Начните с действия &b«Шаблоны жезла»&r: в этой сборке оно, как и другие функции жезла, по умолчанию не настроено.",
  ],
  "quest.3C3703F7BC1BE459.quest_desc": [
    "Мод &e«Украшение предметами»&r позволяет расставлять обычные предметы на поверхностях как декор. Возьмите предмет в основную руку, наведите прицел на блок и нажмите клавишу &b«Разместить предмет»&r.",
    "",
    "По умолчанию эта клавиша не назначена. Найдите её в разделе Plonk настроек управления. Чтобы повернуть уже размещённый предмет, присядьте и нажмите ту же клавишу с пустой рукой.",
  ],
  "quest.5A1DA2B60986EAF9.quest_desc": [
    "Свойства &aнастраиваемого стекла&r можно менять даже после установки. Вы можете выбрать цвет и текстуру, включить свечение или сигнал редстоуна, сделать стекло невидимым и настроить, какие существа смогут проходить сквозь него.",
  ],
  "quest.4676483E1F4B7CA5.quest_desc": [
    "Окна из серии Macaw’s изготавливаются из &aоконной основы&r. С помощью &aоконного молотка&r можно менять форму уже установленного окна, а &2оконным ключом&r — запирать его.",
  ],
  "quest.1CBCDBA892A21481.quest_desc": [
    "&aСтамеска&r позволяет превращать обычные блоки в декоративные. Откройте её нажатием ПКМ, поместите блок в слот и выберите нужный вариант. Один блок обменивается на один.",
    "",
    "Если оставить блок в слоте стамески, Вы сможете нажимать ЛКМ по уже установленным блокам, чтобы менять их внешний вид на выбранный вариант.",
  ],
  "quest.493D3F41AFD2AF3F.title": "&aОдностороннее стекло",
  "quest.7ED0B679AA8D8F35.title": "&aГамаки",
  "quest.22BB5B95E316458D.title": "&aСтроительный жезл архитектора",
  "quest.3774C5D696778FF4.title": "&aДеревянные решётки",
  "quest.4307A169AF52A267.quest_desc": [
    "&aСветящееся стекло&r излучает свет, а &2стекло с редстоуновым сигналом&r подаёт сигнал редстоуна. Такие окна могут служить светильниками или частью редстоуновой схемы.",
    "",
    "&aПризрачное стекло&r пропускает сквозь себя всех существ, в том числе игроков.",
  ],
  "quest.1F9D424E8172A112.quest_desc": [
    "Наполните &aаквариум&r водой из ведра. Затем возьмите сумку с пойманной рыбой, присядьте и нажмите ПКМ по аквариуму, чтобы выпустить рыбу внутрь.",
    "",
    "Мод &e«Улучшенные аквариумы»&r отключает аквариум из Starcatcher, поэтому используйте именно этот вариант.",
  ],
  "quest.5D61821B89B22271.quest_desc": [
    "В этой сборке рыб в аквариуме нужно кормить. Когда рыба начнёт голодать, появится предупреждение. Корм готовится на &aстоле аквариумиста&r; все рецепты можно найти в JEI.",
    "",
    "Поместите готовый корм в слот &b«Корм для рыб»&r внутри аквариума.",
  ],
  "quest.6D8E5365B422735D.title": "&eУлучшенные строительные блоки",
  "quest.7F55F51B79B150FB.title": "&aПанели для декоративного освещения",
  "quest.3C9556B5DA05C0CE.quest_desc": [
    "&aСтеклянные таблички&r позволяют создавать надписи с прозрачной основой. Нажмите ПКМ по установленной табличке с &aмембраной фантома&r в руке — основа исчезнет, а текст останется висеть в воздухе. Мембрана при этом расходуется.",
    "",
    "&cПосле этого вернуть основу таблички уже нельзя.",
  ],
  "quest.12A77A3CB31A42F4.title": "&aМосты",
  "quest.1749497FC966AEFB.title": "&aСумка для переноски рыбы",
  "quest.4676483E1F4B7CA5.title": "&aОкна",
  "task.6700672FB0E2B3E3.title": "Любой спальный мешок",
  "quest.2030D1D78E2AA7DE.title": "&aАвтоматическая стамеска",
  "quest.34EE10F62A7C95EA.quest_desc": [
    "С помощью &aкисти для настройки стекла&r Вы можете менять свойства &2окрашиваемого стекла&r. Нажмите ПКМ с кистью в руке, выберите цвет и настройте свечение, сигнал редстоуна и возможность прохода для игроков и других сущностей. Затем примените настройки к стеклу.",
  ],
  "quest.34EE10F62A7C95EA.title": "&aОкрашиваемое стекло",
  "quest.3F05300BC56B409C.title": "&aДорожки и покрытия",
  "quest.29FE9DA4102EBB42.title": "&eКаркасные блоки",
  "quest.493D3F41AFD2AF3F.quest_desc": [
    "Через это стекло можно смотреть только с одной стороны. Возьмите любой блок и нажмите ПКМ по нужной грани &aодностороннего стекла&r, чтобы замаскировать её. Снаружи такая поверхность будет выглядеть как обычная стена.",
  ],
  "quest.23BAF609BE4D464F.title": "&eБесшовное стекло",
  "quest.3C9556B5DA05C0CE.title": "&aГолографические таблички",
  "quest.5A1DA2B60986EAF9.title": "&eНастраиваемое стекло",
  "quest.66FD982E02F0014A.quest_desc": [
    "&aСпальный мешок&r позволяет переночевать вдали от базы. Чтобы разложить его и сразу лечь спать, присядьте и нажмите ПКМ.",
    "",
    "&cСон в спальном мешке не меняет точку возрождения.",
  ],
  "quest.5D61821B89B22271.title": "&aКормление рыб",
  "quest.1914278B9065D883.quest_desc": [
    "Возьмите &aкровельный молоток&r и нажмите ПКМ по верхней стороне установленной крыши, чтобы изменить её форму. Каменные и бетонные варианты крыш изготавливаются на камнерезе.",
  ],
  "quest.6E0B8B406E7D94CA.title": "&aБеспроводные переключатели",
  "quest.3774C5D696778FF4.quest_desc": [
    "Мод &e«Декоративные деревянные решётки»&r добавляет 90 узоров для каждого вида древесины. Все варианты можно изготовить на камнерезе из досок или обтёсанных брёвен. Используйте решётки для перегородок, перил и оформления окон.",
  ],
  "quest.607211F8C680B88A.quest_desc": [
    "Для каждой разновидности двери нужен свой &aшаблон двери&r. При изготовлении двери этот шаблон расходуется.",
    "",
    "&cМеталлические двери открываются только при подаче сигнала редстоуна.",
  ],
  "quest.1EEA91FF83950090.title": "&aПила для каркасных блоков",
  "quest.3C3703F7BC1BE459.title": "&aУкрашение предметами",
  "quest.1EF4458125E12666.title": "&eНастраиваемые двери",
  "quest.1EEA91FF83950090.quest_desc": [
    "Все дополнительные формы каркасных блоков изготавливаются с помощью &aпилы для каркасов&r. Она превращает &aкаркасные кубы&r в наклонные блоки, лестницы, панели, столбы и другие элементы. Полный список рецептов пилы можно найти в JEI.",
  ],
  "quest.7ED0B679AA8D8F35.quest_desc": [
    "Чтобы повесить гамак, разместите друг напротив друга два &aкрепления с верёвкой и гвоздём&r. В гамаке можно спать днём, пропуская светлое время суток.",
    "",
    "Как и спальные мешки, гамаки не меняют точку возрождения.",
  ],
  "quest.377E6E387004CA7E.title": "&6Камнерез",
  "quest.66FD982E02F0014A.title": "&eУют",
  "quest.1EF4458125E12666.quest_desc": [
    "&aФабрика дверей&r позволяет создавать двери по собственному проекту. Выберите материалы, один из 15 способов открывания, звук и время срабатывания. Можно также добавить автоматическое закрытие, открывание при приближении, управление редстоуном или кодовый замок.",
    "",
    "&cШлюзовые, тюремные, гаражные и раздвижные железные двери работают только от сигнала редстоуна.",
  ],
  "quest.1CBCDBA892A21481.title": "&eСтамеска",
  "quest.6E0B8B406E7D94CA.quest_desc": [
    "Мод &e«Беспроводные переключатели»&r позволяет передавать сигнал редстоуна без проводов. Сначала нажмите &aинструментом для связи&r по переключателю, а затем по блоку, которым он должен управлять. Чтобы сменить режим, прокрутите колёсико мыши с инструментом в руке.",
  ],
  "quest.23B44ACF78688229.title": "Строительные моды &eMacaw’s&r",
}