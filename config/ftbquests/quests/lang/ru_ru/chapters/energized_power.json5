{
  "quest.5F6D849BF0735415.quest_desc": [
    "Аккумуляторы удобно носить с собой, а большие аккумуляторные блоки — устанавливать на базе.",
    "",
    "Соберите &aаккумуляторный блок&r из четырёх аккумуляторов V. Он вмещает 65 536 FE и передаёт до 2 048 FE за тик. Продвинутый и элитный варианты вмещают соответственно 8 388 608 и 268 435 456 FE.",
  ],
  "quest.2418AC7F8E4D0437.title": "Электропечь",
  "quest.0004A2325D5DE642.title": "Сборочная машина",
  "quest.45AEC6C17B2D353C.quest_desc": [
    "Не спешите выливать грязную воду: из неё можно добывать полезные ресурсы.",
    "",
    "Постройте &aочистную установку&r и подавайте в неё грязную воду вместе с &2угольными фильтрами&r. При переработке каждых 100 мБ с вероятностью 33% получится камешек, а с меньшим шансом — рудное сырьё. В этой сборке список возможной добычи дополнен 19 металлами.",
  ],
  "quest.6CD01296F218E3A9.title": "Модули улучшений",
  "quest.4314E0DEC99B8C9C.quest_desc": [
    "Скоростные конвейеры перемещают предметы на один шаг каждые 2 тика.",
    "",
    "Изготовьте комплект &aскоростного конвейера&r: ленту, загрузчик и сортировщик.",
  ],
  "quest.5C58946645097EBF.title": "Кристаллизованный лазурит",
  "quest.39454A3309E666EA.quest_desc": [
    "Элитные механизмы — высшая ступень развития каждой производственной линии.",
    "",
    "Создайте &aэлитную электропечь&r и &2элитный автоматический верстак&r. Такая печь одновременно переплавляет семь стаков предметов, причём в 20 раз быстрее обычной печи Minecraft.",
  ],
  "quest.39454A3309E666EA.title": "Элитные механизмы",
  "quest.0D6C804C2A6E9ECE.title": "Пресс для металла",
  "quest.537D4A1C121F9114.quest_desc": [
    "Самый вместительный аккумуляторный блок в моде.",
    "",
    "Создайте &aэлитный аккумуляторный блок&r из четырёх аккумуляторов X. Он хранит 268 435 456 FE и передаёт до 16 777 216 FE за тик.",
  ],
  "quest.5FE464F00FF65F8E.quest_desc": [
    "Опыт можно собирать и хранить в жидком виде.",
    "",
    "Установите &aсборщик опыта&r над &2малым хранилищем опыта&r. Сборщик поглощает опыт игроков, стоящих на нём, и ближайшие сферы опыта, после чего перемещает его в хранилище снизу.",
  ],
  "quest.61B9CB144078F595.title": "Телепорт",
  "quest.535CC5C59EEBAEF1.quest_desc": [
    "Для передачи жидкостей понадобится отдельная сеть.",
    "",
    "Создайте несколько &aмедных труб для жидкостей&r и &2малый резервуар&r. Медная труба перекачивает 100 мБ за тик с каждой стороны, настроенной на извлечение, стальная — 2 500 мБ, а труба под давлением — 10 000 мБ. Настроить стороны извлечения можно &2гаечным ключом&r.",
    "",
    "Малый резервуар вмещает 8 вёдер, средний — 32, а большой — 128.",
  ],
  "quest.45AEC6C17B2D353C.title": "Очистная установка",
  "quest.41381654B022CD0D.quest_desc": [
    "Два небольших механизма для автоматизации нестандартных задач.",
    "",
    "Создайте &aукладчик блоков&r и &2автоматический камнерез&r. Первый размещает любые блоки, в том числе двери, а также высаживает семена. Второй выполняет рецепты камнереза, если поместить внутрь кирку.",
  ],
  "quest.22059B7A059A6295.title": "Лесопилка",
  "quest.694B3717341A77D5.title": "Сверхпроводник",
  "quest.6F21487103C2B864.quest_desc": [
    "Эти два инструмента помогут разобраться в работе Ваших механизмов.",
    "",
    "Изготовьте &aанализатор энергии&r и &2настройщик механизмов&r. Анализатор показывает запас энергии в блоке, а настройщик переносит настройки сторон и редстоуна с одного механизма на другой.",
  ],
  "quest.61FB33A5F7FACDB9.title": "Дробление и измельчение",
  "quest.22059B7A059A6295.quest_desc": [
    "На лесопилке древесину можно расходовать гораздо экономнее.",
    "",
    "Постройте &aлесопилку&r. Из одного бревна она делает 6 досок и кучку опилок, а ещё позволяет разбирать деревянные предметы на материалы.",
  ],
  "quest.254F71CE27B713D8.quest_desc": [
    "Четвёртый тип каркаса открывает доступ к механизмам, способным изменять окружающий мир.",
    "",
    "Изготовьте &aусиленный продвинутый каркас механизма&r из продвинутого каркаса, четырёх энергизированных кристаллических матриц и четырёх блоков кремния.",
  ],
  "quest.4726F0EF568479F8.quest_desc": [
    "Второй тип каркаса открывает доступ к обработке жидкостей и сборке компонентов.",
    "",
    "Создайте &aзакалённый каркас механизма&r из базового каркаса, железных шестерён, железных стержней, кремния и стали. Он нужен для механизмов по работе с жидкостями, термогенератора и сборочной машины.",
  ],
  "quest.7F452738E6DA6DE2.quest_desc": [
    "Гроза может обеспечить Вас огромным количеством бесплатной энергии — если сумеете её собрать.",
    "",
    "Установите &2громоотвод&r поверх &aгенератора на молниях&r. Каждый удар молнии приносит 1 000 000 FE, а генератор выдаёт до 65 536 FE за тик.",
    "",
    "Чтобы вызывать грозы, используйте контроллер погоды в режиме грозы.",
  ],
  "quest.5F6D849BF0735415.title": "Аккумуляторный блок",
  "quest.39CF1A9F34B62EDD.quest_desc": [
    "В этой сборке улучшенный сплав используется из мода &eFTB Industrial Contraptions&r.",
    "",
    "Получите &aулучшенный сплав&r в &2сплавильной печи&r или индукционной плавильне. Для этого соедините по одному слитку стали и алюминия с двумя слитками бронзы, одним слитком электрума или двумя слитками инвара.",
  ],
  "quest.6AD61318102E2CEE.title": "Элитные улучшения",
  "quest.2418AC7F8E4D0437.quest_desc": [
    "Первый механизм лучше всего сделать заменой обычной печи.",
    "",
    "Постройте &aэлектропечь&r. Она переплавляет предметы вдвое быстрее обычной печи, потребляя 2 FE за тик. &2Модуль улучшения доменной печи&r или &aмодуль улучшения коптильни&r позволяет переключить её на соответствующие рецепты.",
  ],
  "quest.4314E0DEC99B8C9C.title": "Скоростные конвейеры",
  "quest.24394380B59A3DA0.quest_desc": [
    "Любая энергия, которую Вы не сохранили, пропадает зря.",
    "",
    "Создайте &aзарядное устройство&r и постепенно улучшайте аккумуляторы до &2аккумулятора V&r. Каждый следующий уровень аккумулятора изготавливается из предыдущего, а &2разрядное устройство&r возвращает накопленную энергию в сеть.",
  ],
  "quest.4C97C7EB355F1A8C.quest_desc": [
    "У каждого базового перерабатывающего механизма есть более производительная версия.",
    "",
    "Постройте &aпродвинутую электропечь&r, &2продвинутый измельчитель&r и продвинутую дробилку. Измельчитель и дробилка работают в четыре раза быстрее обычных, расходуют 10 мБ воды на рецепт и вырабатывают &2грязную воду&r.",
  ],
  "quest.6A59069E389CBA24.title": "Камера выращивания кристаллов",
  "quest.4AD16D2958B25FFB.title": "Авто-крафтер",
  "quest.5A08FA1A20258BB2.quest_desc": [
    "Теперь можно пропускать ночь без кровати.",
    "",
    "Создайте &aконтроллер времени&r. За 8 388 608 FE он переводит время суток на утро, полдень, вечер или полночь. При этом время движется только вперёд.",
  ],
  "quest.5A08FA1A20258BB2.title": "Управление временем",
  "quest.1B51F2E8350A3145.quest_desc": [
    "Для настройки блоков этого мода нужен всего один инструмент.",
    "",
    "Изготовьте &aгаечный ключ&r. Им можно задать стороны извлечения жидкости из труб, наклон конвейерной ленты и рабочие стороны настраиваемого трансформатора.",
  ],
  "quest.41381654B022CD0D.title": "Установка блоков и обработка камня",
  "quest.4AD16D2958B25FFB.quest_desc": [
    "Ручное изготовление предметов быстро становится узким местом в автоматизации.",
    "",
    "Постройте &aавто-крафтер&r. Задайте ему схему крафта, и он начнёт создавать предметы при поступлении ингредиентов. Продвинутый автоматический верстак работает сразу с несколькими рецептами, а элитный — ещё и быстрее.",
  ],
  "quest.694B3717341A77D5.quest_desc": [
    "Для кабелей высшего уровня необходим проводник, который постоянно охлаждается.",
    "",
    "Сначала изготовьте &aохлаждающие ячейки&r, а затем соберите из них &2сверхпроводники&r, добавив кристаллизованный лазурит, пластины энергизированного сплава и энергизированную золотую проволоку.",
  ],
  "quest.11EABC139262D289.quest_desc": [
    "Компактное хранилище большого количества предметов одного вида.",
    "",
    "Постройте &aмалый силос для предметов&r. Он вмещает 50 стаков одного предмета; загружать и выгружать их можно только воронками, конвейерами и другими средствами автоматизации. Огромный силос вмещает 1 000 стаков.",
  ],
  "quest.65A01F46F7044328.quest_desc": [
    "В основе каждого механизма этого мода лежит каркас. Начните с &aбазового машинного корпуса&r.",
    "",
    "Изготовьте &aбазовый машинный корпус&r. В этой сборке для него нужен &2стальной слиток&r в центральной ячейке. Получить сталь можно в &aсплавильной печи&r из железного слитка и угля.",
    "",
    "Базовый корпус также служит рабочим блоком для жителя-&dэлектрика&r. Электрики продают изоляторы для кабелей, аккумуляторы, провода и некоторые начальные механизмы.",
  ],
  "quest.06701D04327780C6.quest_desc": [
    "Один автоматический верстак способен работать с несколькими рецептами.",
    "",
    "Постройте &aпродвинутый автоматический верстак&r. Он хранит сразу несколько шаблонов крафта и работает вдвое быстрее базового.",
  ],
  "quest.537D4A1C121F9114.title": "Элитный аккумуляторный блок",
  "quest.5A559FF1147D2459.title": "Зарядная станция",
  "quest.454517F5F0917F46.title": "Солнечные панели",
  "quest.65A01F46F7044328.title": "Базовый машинный корпус",
  "quest.1B95E11A97F6D2C6.title": "Термогенератор",
  "quest.196DBB74F9A47B69.quest_desc": [
    "Мод &eEnergized Power&r предлагает полноценную технологическую цепочку: от генераторов, кабелей и перерабатывающих машин до устройств для телепортации и изменения погоды.",
    "",
    "Развивайтесь от одного каркаса механизмов к другому, двигаясь слева направо. Каждый новый каркас открывает следующую группу машин. Соответствующие задания расположены над ним и под ним.",
    "",
    "&eПримечание&r: В этой сборке некоторые особенности мода изменены. Угольный двигатель удалён, для первого каркаса требуется сталь, а многие пластины, провода и виды пыли создаются средствами &eFTB Materials&r.",
  ],
  "quest.0004A2325D5DE642.quest_desc": [
    "Схемы сложнее базовой изготавливаются в сборочной машине, а не на верстаке.",
    "",
    "Постройте &aсборочную машину&r. Она создаёт продвинутые схемы, вычислительные блоки, солнечные элементы и кристаллическую матрицу, которая понадобится для каркасов более высокого уровня.",
  ],
  "quest.3C141E8FE709BDF2.title": "Управление погодой",
  "quest.64D5A4564AB0C180.title": "Индукционная плавильня",
  "quest.2A868E9D86980F2C.quest_desc": [
    "У этого мода есть собственное руководство.",
    "",
    "Создайте &aруководство Energized Power&r. Нажмите левой кнопкой мыши по любому блоку мода, держа книгу, чтобы открыть страницу с его описанием.",
    "",
    "&eПримечание&r: Некоторые страницы описывают механики, изменённые в этой сборке, например угольный двигатель или выплавку кремния из кварца.",
  ],
  "quest.3F44E3225E41C7CF.title": "Элитный каркас механизма",
  "quest.5C58946645097EBF.quest_desc": [
    "Выращивание кристаллизованного лазурита занимает немало времени.",
    "",
    "Получите &aкристаллизованный лазурит&r в камере выращивания кристаллов. На одну единицу нужно 8 лазурита и 128 000 тиков — более пяти игровых суток без ускорения. Зато один готовый кристалл можно размножить за 32 000 тиков, поэтому сохраните первый.",
    "",
    "&eПримечание&r: В подсказке к предмету рекомендуется заранее установить в камеру два комплекта улучшений VI уровня.",
  ],
  "quest.3F44E3225E41C7CF.quest_desc": [
    "Для создания каркаса высшего уровня понадобится дорогой сплав.",
    "",
    "Соедините кристаллизованный лазурит, кристаллическую матрицу и улучшенный сплав, чтобы получить &2кристаллизованный сплав&r. Затем зарядите его, потратив 8 388 608 FE, и получите &aэнергизированный сплав&r. Из него создаётся &aэлитный каркас механизма&r.",
    "",
    "&eПримечание&r: Чтобы энергизатор мог накопить достаточно энергии для создания сплава, ему нужен модуль увеличения энергоёмкости IV уровня или выше.",
  ],
  "quest.5A559FF1147D2459.quest_desc": [
    "Больше не придётся каждый раз доставать инструменты из инвентаря для подзарядки.",
    "",
    "Постройте &aзарядную станцию&r. Она заряжает предметы у всех игроков в радиусе 7 блоков. Модули увеличения радиуса позволяют расширить зону действия.",
  ],
  "quest.6AD61318102E2CEE.quest_desc": [
    "Улучшения VII и VIII уровня создаются на основе элитного модуля.",
    "",
    "Изготовьте &aэлитный модуль улучшения&r. Модуль скорости VIII уровня ускоряет механизм в 40 раз, но увеличивает энергопотребление в 80 раз. Модуль энергоёмкости VIII уровня увеличивает запас энергии и скорость её передачи в 80 раз.",
  ],
  "quest.39CF1A9F34B62EDD.title": "Улучшенный сплав",
  "quest.52A6CCD14E5E5144.quest_desc": [
    "Поскольку угольный двигатель в сборке отсутствует, на ранних этапах энергию можно получать из лавы или солнечных панелей.",
    "",
    "Постройте &aтепловой генератор&r и разместите лаву вплотную к его сторонам. Каждый соприкасающийся с ним блок неподвижной лавы даёт 25 FE за тик, а текущей — 15 FE за тик. Если окружить лавой все шесть сторон, можно получить до 150 FE за тик.",
  ],
  "quest.3CAB8C8CA70E31C9.title": "Камера выращивания растений",
  "quest.7F452738E6DA6DE2.title": "Генератор на молниях",
  "quest.254F71CE27B713D8.title": "Усиленный продвинутый каркас",
  "quest.2CE134BC4AFE943F.quest_desc": [
    "Обычная конвейерная лента перемещает предметы на один шаг каждые 10 тиков.",
    "",
    "Создайте &aбыстрые конвейерные ленты&r, которые перемещают предметы каждые 6 тиков.",
  ],
  "quest.6F21487103C2B864.title": "Анализатор и настройщик",
  "quest.2D9A1A4DBC4D54BC.title": "Камень и вода",
  "quest.61B9CB144078F595.quest_desc": [
    "Ходить пешком приходится только тем, у кого нет лишних восьми миллионов FE.",
    "",
    "Создайте два &aтелепорта&r и &2матрицу телепортации&r. Присядьте и нажмите правой кнопкой по телепорту назначения с матрицей в руке, чтобы привязать её. Затем поместите матрицу во второй телепорт, встаньте на него и активируйте редстоуном или назначенной клавишей телепортации.",
    "",
    "Каждый перенос расходует весь запас в 8 388 608 FE. Телепортация работает и между измерениями.",
  ],
  "quest.2CC87ECDB76CCBD1.quest_desc": [
    "Третий тип каркаса открывает доступ к по-настоящему быстрым механизмам.",
    "",
    "Изготовьте &aпродвинутый каркас механизма&r из закалённого каркаса, двух единиц улучшенного сплава, кремния и четырёх латунных слитков.",
  ],
  "quest.0D6C804C2A6E9ECE.quest_desc": [
    "Чтобы изготавливать металлические детали, нужен пресс.",
    "",
    "Постройте &aпресс для металла&r. Установленная пресс-форма позволяет превращать пластины в провода, стержни или шестерни. Каждое использование немного изнашивает форму.",
    "",
    "Пластины изготавливаются в &2компрессоре&r.",
  ],
  "quest.627553EDEFCE9C01.quest_desc": [
    "Шестерни и стержни в этой сборке не создаются обычным крафтом.",
    "",
    "Постройте &aстанок для изготовления пресс-форм&r, сформуйте из глины заготовки и обожгите их. &aПресс-форма для шестерён&r и &2пресс-форма для стержней&r позволят изготавливать в прессе железные детали, необходимые для следующего каркаса.",
    "",
    "Обычных пресс-форм хватает на 2 000 операций. Закалённые, продвинутые и элитные служат значительно дольше.",
  ],
  "quest.5D5E354DBE1226B7.title": "Кристаллическая матрица",
  "quest.763CFE19384B50BF.quest_desc": [
    "Турбоконвейеры перемещают предметы каждый тик.",
    "",
    "Изготовьте &aтурбоконвейерные ленты&r. Для них нужен кристаллизованный сплав, поэтому доступны они ближе к поздним этапам развития.",
  ],
  "quest.454517F5F0917F46.quest_desc": [
    "Солнечным панелям для работы нужны лишь дневной свет и открытое небо.",
    "",
    "Создайте &aсолнечные панели&r вплоть до III уровня. Каждый следующий уровень создаётся из предыдущего. В этой сборке максимальная выработка панелей уровней I–VII составляет соответственно 2, 16, 64, 256, 512, 4 096 и 16 000 FE за тик.",
    "",
    "&eПримечание&r: Модули лунного освещения позволяют панелям работать и ночью.",
  ],
  "quest.1B95E11A97F6D2C6.quest_desc": [
    "Вместо того чтобы окружать генератор лавой, можно подавать её по трубам.",
    "",
    "Постройте &aтермогенератор&r и подведите к нему лаву. В этой сборке ведро лавы даёт 10 000 FE, а максимальная выработка генератора составляет 500 FE за тик.",
  ],
  "quest.5A1884B152041DF2.title": "Конвейерные ленты",
  "quest.52A6CCD14E5E5144.title": "Тепловой генератор",
  "quest.196DBB74F9A47B69.title": "Энергетика",
  "quest.535CC5C59EEBAEF1.title": "Трубы и резервуары",
  "quest.5A1884B152041DF2.quest_desc": [
    "Конвейеры перемещают предметы без труб, причём всё содержимое ленты остаётся на виду.",
    "",
    "Изготовьте &aконвейерную ленту&r, &2загрузчик конвейера&r и сортировщик конвейера. Загрузчик забирает предметы из хранилища и выкладывает на ленту, ленты передают предметы в блок перед собой, а сортировщик по фильтрам направляет их влево, прямо или вправо.",
    "",
    "В каждой линейке конвейеров также доступны разделители, объединители и переключатели.",
  ],
  "quest.6CD01296F218E3A9.quest_desc": [
    "Большинство механизмов поддерживают улучшения, и даже самые доступные полезны уже в начале игры.",
    "",
    "Создайте &aбазовый модуль улучшения&r и превратите его в &2модуль скорости I уровня&r. Он ускоряет механизм в 1,2 раза, увеличивая расход энергии в 1,4 раза. По аналогичному принципу работают модули энергоэффективности, энергоёмкости, выбрасывания и извлечения предметов.",
    "",
    "Устанавливать улучшения нужно вручную в специальном окне механизма. Для высоких уровней потребуются продвинутые, усиленные и элитные модули.",
  ],
  "quest.06701D04327780C6.title": "Продвинутый автоматический верстак",
  "quest.2CE134BC4AFE943F.title": "Быстрые конвейеры",
  "quest.5FE464F00FF65F8E.title": "Жидкий опыт",
  "quest.2CC87ECDB76CCBD1.title": "Продвинутый каркас механизма",
  "quest.3C141E8FE709BDF2.quest_desc": [
    "Хотите вызвать дождь — или, наоборот, навсегда от него избавиться?",
    "",
    "Постройте &aконтроллер погоды&r. Он позволяет включить ясную погоду, дождь или грозу. Каждая смена погоды полностью расходует накопленные 8 388 608 FE. Модули продолжительности продлевают выбранную погоду, а модуль VI уровня поддерживает её, пока контроллер получает энергию.",
  ],
  "quest.2D9A1A4DBC4D54BC.quest_desc": [
    "Вода и лава превращаются в блоки, а блоки можно снова переработать в жидкости.",
    "",
    "Создайте &aустановку затвердевания камня&r, &2установку плавления камня&r и установку замораживания жидкостей. Первая производит булыжник, камень и обсидиан из воды и лавы. Вторая плавит камень в лаву, а третья превращает воду в лёд и снег.",
  ],
  "quest.2A868E9D86980F2C.title": "Руководство по энергетике",
  "quest.6A59069E389CBA24.quest_desc": [
    "Некоторые ресурсы проще не добывать, а выращивать.",
    "",
    "Постройте &aкамеру выращивания кристаллов&r. В ней можно выращивать осколки аметиста, цветущий аметист и кристаллизованный лазурит, а в этой сборке — ещё и материалы для самоцветов из мода &eGeOre&r.",
    "",
    "Камера потребляет 1 024 FE за тик, а рецепты выполняются от 16 000 до 128 000 тиков. Поэтому модули ускорения стоит установить как можно раньше.",
  ],
  "quest.763CFE19384B50BF.title": "Турбоконвейеры",
  "quest.24394380B59A3DA0.title": "Зарядка и аккумуляторы",
  "quest.11EABC139262D289.title": "Хранилища предметов",
  "quest.5D5E354DBE1226B7.quest_desc": [
    "Для следующего каркаса понадобится энергизированный кристалл.",
    "",
    "Соберите &aкристаллическую матрицу&r из аметиста, алмазов, изумрудов и редстоунового сплава. Затем зарядите её за 524 288 FE и получите &2энергизированную кристаллическую матрицу&r.",
  ],
  "quest.627553EDEFCE9C01.title": "Пресс-формы",
  "quest.4726F0EF568479F8.title": "Закалённый каркас механизма",
  "quest.2D1B85CD83A93F5E.title": "Сверхпроводящий кабель",
  "quest.4C97C7EB355F1A8C.title": "Продвинутая переработка",
  "quest.3CAB8C8CA70E31C9.quest_desc": [
    "Чтобы выращивать растения, больше не нужны обычные грядки.",
    "",
    "Постройте &aкамеру выращивания растений&r. Положите семена в ячейку для семян, подходящий блок почвы — в ячейку для грунта, и камера вырастит урожай, расходуя воду и электричество.",
    "",
    "Тип почвы влияет на работу: грядка ускоряет выращивание в 1,5 раза при меньшем расходе энергии, грязь сокращает потребление воды вдвое, а мицелий вдвое ускоряет рост грибов. Удобрение в третьей ячейке дополнительно ускоряет процесс, но повышает энергопотребление.",
  ],
  "quest.64D5A4564AB0C180.quest_desc": [
    "Сплавильная печь работает на топливе, а &aиндукционная плавильня&r выполняет те же рецепты за счёт электричества.",
    "",
    "Постройте &aиндукционную плавильню&r. Она производит сплавы вдвое быстрее, расходуя 64 FE за тик.",
  ],
  "quest.2D1B85CD83A93F5E.quest_desc": [
    "Даже кабель из энергизированной кристаллической матрицы передаёт не больше 2 097 152 FE за тик.",
    "",
    "Изготовьте &aсверхпроводящий кабель&r. Он передаёт до 16 777 216 FE за тик — больше любого другого кабеля мода. Как и остальные кабели, соединять его с кабелями других уровней можно только через трансформатор.",
  ],
  "quest.1B51F2E8350A3145.title": "Гаечный ключ",
  "quest.61FB33A5F7FACDB9.quest_desc": [
    "Эти два механизма перерабатывают материалы, но выполняют разные задачи.",
    "",
    "Создайте &aизмельчитель&r и &2дробилку&r. Измельчитель превращает руду и слитки в пыль с шансом получить дополнительные материалы. Дробилка перерабатывает камень в булыжник, затем гравий и песок.",
    "",
    "Оба механизма потребляют 8 FE за тик. Их улучшенные версии становятся доступны после создания продвинутого каркаса.",
  ],
}